# Builds
*.apk
*.aab
*.unitypackage
*.app
*.exe

# Crashlytics / logs
sysinfo.txt
crashlytics-build.properties
/[Aa]ssets/Plugins/Android/google-services*

# Archivos del sistema
.DS_Store
Thumbs.db
Desktop.ini

# Resultados de tests y profiling
/[Aa]ssets/Tests/Results/
TestResults*/
*.stackdump

# Gradle / Android / iOS
/[Aa]ssets/Plugins/Android/*.androidlib/build/
/[Aa]ssets/Plugins/iOS/**/build/
*.keystore
*.jks

# Paquetes locales
/[Pp]ackages/packages-lock.json.bak

# Mantener explícitamente (no ignorar)
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json